#!/bin/sh
# bin/scheme-desktop -- this shell's entry point.
#
# All the environment work is scheme-toolkit's: the layer-shell preload and the
# two library paths are load-bearing and easy to get wrong, so they live in one
# place.  This wrapper only adds the extra -L for this checkout, so that
# (scheme-desktop ...) resolves alongside (scheme-toolkit ...).
#
#   run [args]   start the shell
#   gdb [args]   the same, under gdb; prints a backtrace when the shell stops
#   eval EXPR    evaluate an expression in the running shell (later: D4)

set -e

SELF="$(readlink -f "$0")"
DESKTOP_ROOT="$(dirname "$(dirname "$SELF")")"
TOOLKIT_ROOT="$(dirname "$DESKTOP_ROOT")/scheme-toolkit"

[ -x "$TOOLKIT_ROOT/bin/scheme-toolkit" ] || {
    echo "scheme-desktop: cannot find scheme-toolkit at $TOOLKIT_ROOT" >&2
    echo "the two are built in tandem and this one depends on it" >&2
    exit 1
}

case "${1:-run}" in
    run)
        # Guard the shift.  Bare `shift' with no positional arguments fails
        # ("shift count out of range"), which is the NORMAL case for
        # `scheme-desktop' with no arguments -- the default is run.  `|| true'
        # kept it from aborting but still printed the message, so every plain
        # start showed a spurious error before the shell came up.
        #
        # Written as an if rather than `[ $# -gt 0 ] && shift': the && form
        # returns non-zero when there is nothing to shift, and under `set -e'
        # that aborts the script -- which is the very case this is fixing.
        if [ $# -gt 0 ]; then shift; fi
        # scheme-toolkit run supplies the environment and the toolkit's load
        # path; -L adds this checkout so (scheme-desktop ...) resolves.
        exec "$TOOLKIT_ROOT/bin/scheme-toolkit" guile \
             -L "$DESKTOP_ROOT" \
             -e main -s "$DESKTOP_ROOT/scheme-desktop/shell.scm" "$@"
        ;;
    gdb)
        if [ $# -gt 0 ]; then shift; fi
        # NO -L HERE, unlike `run': the toolkit's own load_args adds an -L for
        # every sibling checkout, so (scheme-desktop ...) already resolves, and
        # passing the file as the target is what the toolkit's `gdb' wants.
        exec "$TOOLKIT_ROOT/bin/scheme-toolkit" gdb \
             "$DESKTOP_ROOT/scheme-desktop/shell.scm" "$@"
        ;;

    dump-menu)
        # Write the whole menu -- settings included -- as s-expressions.  In
        # Scheme because it makes the widgets the config names and asks each for
        # its options; the same module is what a REPL inside the shell calls, so
        # this is the *no shell needed* way to the same file.
        if [ $# -gt 0 ]; then shift; fi
        exec "$TOOLKIT_ROOT/bin/scheme-toolkit" guile \
             -L "$DESKTOP_ROOT" \
             -s "$DESKTOP_ROOT/tools/dump-menu.scm" "$@"
        ;;

    install|remove|enable|disable|update|plugins)
        # PLUGINS.  In Scheme, because enabling a widget means asking the widget
        # -- its `widget-enable!' -- and that is Scheme code.  The same
        # environment and load path as `run', so a plugin's classes resolve.
        exec "$TOOLKIT_ROOT/bin/scheme-toolkit" guile \
             -L "$DESKTOP_ROOT" \
             -s "$DESKTOP_ROOT/tools/plugin-cli.scm" "$@"
        ;;

    *)
        # Everything else is scheme-toolkit's (eval, repl, list, check-env).
        exec "$TOOLKIT_ROOT/bin/scheme-toolkit" "$@"
        ;;
esac
